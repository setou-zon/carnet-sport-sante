# ---------------------------------------------------------------
# Carnet Sport Santé / Sport pour tous — configuration du serveur
# Copier ce fichier en .env puis compléter les valeurs marquées ⚠
# ---------------------------------------------------------------

APP_NAME="Carnet Sport Santé"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# ⚠ Adresse publique de l'application (sert aussi aux liens « mot de passe oublié »)
APP_URL=https://sportsante.exemple.gov.bf

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ⚠ Base de données (MySQL / MariaDB recommandé ; PostgreSQL possible avec DB_CONNECTION=pgsql)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sportsante
DB_USERNAME=sportsante
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ⚠ Envoi des emails (lien « mot de passe oublié ») : serveur de messagerie du ministère
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.exemple.gov.bf
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="ne-pas-repondre@exemple.gov.bf"
MAIL_FROM_NAME="Carnet Sport Santé (MSJE)"
